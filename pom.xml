<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Identidad del proyecto -->
    <groupId>com.nacho</groupId>
    <artifactId>football-career</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <!-- Java -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- JavaFX -->
        <javafx.version>21.0.9</javafx.version>

        <!-- Tests -->
        <junit.version>5.13.4</junit.version>
    </properties>

    <!-- ========================= -->
    <!-- DEPENDENCIAS              -->
    <!-- ========================= -->

    <dependencies>

        <!-- JavaFX Controls -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- JavaFX FXML -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- SQLite -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.53.2.1</version>
        </dependency>

        <!-- JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ========================= -->
    <!-- BUILD                     -->
    <!-- ========================= -->

    <build>

        <plugins>

            <!-- Compilador Java -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>

                <configuration>
                    <release>21</release>
                    <showWarnings>true</showWarnings>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- Ejecutar tests JUnit 5 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
                <configuration>
                    <systemPropertyVariables>
                        <footballcareer.database.url>jdbc:sqlite:target/football-career-test.db</footballcareer.database.url>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- Ejecutar JavaFX -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>

                <configuration>
                    <mainClass>footballcareer.Main</mainClass>
                </configuration>
            </plugin>

        </plugins>

    </build>

    <profiles>
        <!-- Validación habitual durante el desarrollo: persistencia y flujos críticos. -->
        <profile>
            <id>fast</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/DatabaseIsolationTest.java</include>
                                <include>**/AppDiagnosticsTest.java</include>
                                <include>**/SourceEncodingTest.java</include>
                                <include>**/CareerMatchIsolationTest.java</include>
                                <include>**/CareerTransferIsolationTest.java</include>
                                <include>**/CareerInsightServiceTest.java</include>
                                <include>**/TransferOfferServiceTest.java</include>
                                <include>**/LoanServiceTest.java</include>
                                <include>**/YouthAcademyServiceTest.java</include>
                                <include>**/StaffServiceTest.java</include>
                                <include>**/ViewportPolicyTest.java</include>
                                <include>**/CareerShellIconographyTest.java</include>
                                <include>**/NavigationStateTest.java</include>
                                <include>**/ManagerReputationServiceTest.java</include>
                                <include>**/CareerActivityServiceTest.java</include>
                                <include>**/ArchitectureBoundaryTest.java</include>
                                <include>**/CareerNavigationControllerTest.java</include>
                                <include>**/MarketSearchControllerTest.java</include>
                                <include>**/CareerRepairServiceTest.java</include>
                                <include>**/ClubTransferAiServiceTest.java</include>
                                <include>**/LeagueStandingRepositoryTest.java</include>
                                <include>**/PlayerStatsAndLineupTest.java</include>
                                <include>**/Day9IntegrationTest.java</include>
                                <include>**/TrainingServiceTest.java</include>
                                <include>**/MatchSimulationTacticsTest.java</include>
                                <include>**/LiveMatchExperienceTest.java</include>
                                <include>**/PlayerConversationServiceTest.java</include>
                                <include>**/ClubNegotiationPolicyTest.java</include>
                                <include>**/PlayerAgentServiceTest.java</include>
                                <include>**/CareerDifficultyServiceTest.java</include>
                                <include>**/ManagerIdentityServiceTest.java</include>
                                <include>**/TransferHistoryServiceTest.java</include>
                                 <include>**/MatchRoleRepositoryTest.java</include>
                                 <include>**/TeamSheetRepositoryTest.java</include>
                                 <include>**/PlayerRoleAssessmentServiceTest.java</include>
                                 <include>**/PlayerProgressSummaryServiceTest.java</include>
                                 <include>**/JavaFxLayoutSmokeTest.java</include>
                                 <include>**/PlayerRepositoryCacheTest.java</include>
                                 <include>**/IncrementalLiveMatchServiceTest.java</include>
                                 <include>**/RetainedScreenStoreTest.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
